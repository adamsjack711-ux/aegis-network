{
  "commands": {
    "ai-alpha-integrated": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=../phase-next-alpha-integration/src ../../.venv/bin/python ../phase-next-alpha-integration/scripts/phase5a_alpha_evaluate.py --root ../phase-next-alpha-integration --output benchmarks/phase-next-release-validation/runs/ai-alpha-integrated.json --repeats 3",
    "ai-h12-integrated": "PYTHONDONTWRITEBYTECODE=1 ../../.venv/bin/python scripts/phase_next_ai_eval.py --baseline-command \"../../.venv/bin/python scripts/phase_next_5a_adapter.py --candidate-root ../phase-next-alpha-integration --source-pin d15a3a756b8066c5cb2d98665662220e52f4a7d6\" --baseline-pin d15a3a756b8066c5cb2d98665662220e52f4a7d6 --output benchmarks/phase-next-release-validation/runs/ai-h12-integrated.json",
    "ai-v12-integrated": "same evaluator with --corpus benchmarks/phase-next-release-validation/oracles/phase-next-alpha-ai-holdout-v1.json, output ai-v12-integrated.json",
    "cli-five-linux-integrated": "docker run --rm --pull never --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --tmpfs /tmp:rw,noexec,nosuid,size=32m -e PYTHONPATH=/candidate/src -e PYTHONDONTWRITEBYTECODE=1 -v ../phase-next-alpha-integration/src:/candidate/src:ro -v scripts/phase_next_probe_cli.py:/probe.py:ro sha256:f4d96476e0c78b0a45c25acaed6cfc770e469058d23c888ae0e14047f89eebab python3 /probe.py",
    "cli-resource-retained-rescore": "Python one-off SHA-256 checked rescore of retained 100000-row Debian and Ubuntu hybrid raw JSON; no fresh benchmark",
    "cli-status-integrated": "PYTHONDONTWRITEBYTECODE=1 ../../.venv/bin/python scripts/phase_next_5b_status_challenge.py --candidate-root ../phase-next-alpha-integration --source-pin d15a3a756b8066c5cb2d98665662220e52f4a7d6 --fixture-root fixtures/phase-next-cli --output benchmarks/phase-next-release-validation/runs/cli-status-integrated.json",
    "focused-integrated": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=../phase-next-alpha-integration/src ../../.venv/bin/pytest -q -p no:cacheprovider ../phase-next-alpha-integration/tests/test_phase5a_alpha_eval.py ../phase-next-alpha-integration/tests/test_phase5a_intelligence.py ../phase-next-alpha-integration/tests/test_phase5a_claim_integrity.py ../phase-next-alpha-integration/tests/test_phase5b_cli.py --junitxml=benchmarks/phase-next-release-validation/runs/focused-integrated.xml",
    "native-defensive-integrated": "first collection attempt, PYTHONPATH lacking tests/phase4d; retained exit 2",
    "native-defensive-integrated-corrected": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=../phase-next-alpha-integration/src:../phase-next-alpha-integration/scripts:../phase-next-alpha-integration/tests/phase4d ../../.venv/bin/pytest -q -p no:cacheprovider ../phase-next-alpha-integration/tests/phase4e/test_defensive_validation.py --junitxml=benchmarks/phase-next-release-validation/runs/native-defensive-integrated-corrected.xml",
    "native-healthy-integrated": "same command with --kill-agent omitted, fresh state, output native-healthy-integrated.json",
    "native-preintake-integrated": "PYTHONDONTWRITEBYTECODE=1 ../../.venv/bin/python scripts/phase4e_withdrawal_recovery_check.py ../phase-next-alpha-integration --authorize-local-lab --kill-agent --priority --ordinary-count 4 --output benchmarks/phase-next-release-validation/runs/native-preintake-integrated.json",
    "native-repeat2-integrated": "same crash/restart command, fresh state, output native-repeat2-integrated.json",
    "native-repeat3-integrated": "same crash/restart command, fresh state, output native-repeat3-integrated.json",
